<?xml version="1.0" encoding="utf-8"?>
<!-- "Ne kadar oynuyorsun?" seçenekleri: odak > seçili > normal -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/home_accent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="@color/home_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/home_outline" />
        </shape>
    </item>
</selector>
