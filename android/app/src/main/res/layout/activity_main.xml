<?xml version="1.0" encoding="utf-8"?>
<!-- AltyazıTR: Google TV ana ekranı. Kenarlar TV güvenli alanı için 48dp / 27dp. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="27dp"
    android:paddingBottom="27dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context="com.metallic.chiaki.main.MainActivity">

    <!-- Üst çubuk: logo, ad, slogan, Hakkında -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/logoImageView"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_altyazi_mark"
            android:contentDescription="@string/home_content_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/brandTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_brand_name"
                android:textColor="@color/home_text"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/taglineTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/home_tagline"
                android:textColor="@color/home_text_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- AltyazıTR Pro rozeti: abonelik ekranını açar -->
        <TextView
            android:id="@+id/proButton"
            style="@style/Home.Pill"
            android:layout_marginEnd="10dp"
            android:text="@string/home_pro_badge"
            android:nextFocusRight="@+id/aboutButton"
            android:nextFocusDown="@+id/tileRemotePlay" />

        <TextView
            android:id="@+id/aboutButton"
            style="@style/Home.Pill"
            android:text="@string/home_about"
            android:nextFocusLeft="@id/proButton"
            android:nextFocusDown="@+id/tileRemotePlay" />
    </LinearLayout>

    <!-- Orta alan: durum kartı + kutucuklar -->
    <LinearLayout
        android:id="@+id/mainArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Durum kartı -->
        <LinearLayout
            android:id="@+id/heroCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.45"
            android:orientation="vertical"
            android:background="@drawable/bg_home_hero"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="22dp"
            android:paddingBottom="22dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/heroLabelTextView"
                style="@style/Home.SectionLabel"
                android:text="@string/home_section_selected" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/heroIconImageView"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_home_console"
                    android:importantForAccessibility="no"
                    app:tint="@color/home_accent" />

                <TextView
                    android:id="@+id/heroNameTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/home_text"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="PS5-123" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/heroChipsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/stateChip"
                    style="@style/Home.Chip">

                    <ImageView
                        android:id="@+id/stateDotImageView"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/bg_home_dot"
                        android:importantForAccessibility="no"
                        app:tint="@color/home_ready" />

                    <TextView
                        android:id="@+id/stateTextView"
                        style="@style/Home.ChipText"
                        tools:text="Hazır" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ipChip"
                    style="@style/Home.Chip"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:id="@+id/ipTextView"
                        style="@style/Home.ChipText"
                        android:layout_marginStart="2dp"
                        android:textColor="@color/home_text_muted"
                        tools:text="IP: 192.168.1.20" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/captionChip"
                    style="@style/Home.Chip"
                    android:layout_marginStart="10dp">

                    <ImageView
                        android:id="@+id/captionDotImageView"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/bg_home_dot"
                        android:importantForAccessibility="no"
                        app:tint="@color/home_offline" />

                    <TextView
                        android:id="@+id/captionTextView"
                        style="@style/Home.ChipText"
                        tools:text="Altyazı kapalı" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Telefondan kontrol adresi (küçük ipucu) -->
            <LinearLayout
                android:id="@+id/companionHintLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_home_phone"
                    android:importantForAccessibility="no"
                    app:tint="@color/home_text_faint" />

                <TextView
                    android:id="@+id/companionHintTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/home_text_faint"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Telefondan kontrol: http://192.168.1.20:8642" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroHintTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/home_text_muted"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="@string/home_hint_start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primaryButton"
                style="@style/Home.PrimaryButton"
                android:layout_width="wrap_content"
                android:minWidth="340dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:nextFocusRight="@+id/tileRemotePlay"
                android:nextFocusUp="@id/aboutButton"
                app:icon="@drawable/ic_home_play"
                tools:text="@string/home_action_start">

                <requestFocus />
            </com.google.android.material.button.MaterialButton>
        </LinearLayout>

        <!-- İkincil işlemler -->
        <LinearLayout
            android:id="@+id/tilesLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/tileRemotePlay"
                style="@style/Home.Tile"
                android:nextFocusLeft="@id/primaryButton">

                <ImageView
                    style="@style/Home.TileIcon"
                    android:src="@drawable/ic_home_tv" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Home.TileTitle"
                        android:text="@string/home_tile_remote_play" />

                    <TextView
                        style="@style/Home.TileSubtitle"
                        android:text="@string/home_tile_remote_play_sub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileSettings"
                style="@style/Home.Tile"
                android:layout_marginTop="12dp"
                android:nextFocusLeft="@id/primaryButton">

                <ImageView
                    style="@style/Home.TileIcon"
                    android:src="@drawable/ic_home_tune" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Home.TileTitle"
                        android:text="@string/home_tile_settings" />

                    <TextView
                        style="@style/Home.TileSubtitle"
                        android:text="@string/home_tile_settings_sub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tilePair"
                style="@style/Home.Tile"
                android:layout_marginTop="12dp"
                android:nextFocusLeft="@id/primaryButton">

                <ImageView
                    style="@style/Home.TileIcon"
                    android:src="@drawable/ic_home_add" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Home.TileTitle"
                        android:text="@string/home_tile_pair" />

                    <TextView
                        style="@style/Home.TileSubtitle"
                        android:text="@string/home_tile_pair_sub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileCompanion"
                style="@style/Home.Tile"
                android:layout_marginTop="12dp"
                android:nextFocusLeft="@id/primaryButton">

                <ImageView
                    style="@style/Home.TileIcon"
                    android:src="@drawable/ic_home_phone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Home.TileTitle"
                        android:text="@string/companion_tile_title" />

                    <TextView
                        style="@style/Home.TileSubtitle"
                        android:text="@string/companion_tile_sub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tileHelp"
                style="@style/Home.Tile"
                android:layout_marginTop="12dp"
                android:nextFocusLeft="@id/primaryButton">

                <ImageView
                    style="@style/Home.TileIcon"
                    android:src="@drawable/ic_home_help" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Home.TileTitle"
                        android:text="@string/home_tile_help" />

                    <TextView
                        style="@style/Home.TileSubtitle"
                        android:text="@string/home_tile_help_sub" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Birden fazla konsol varsa seçim sırası -->
    <LinearLayout
        android:id="@+id/consolesSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/consolesLabelTextView"
            style="@style/Home.SectionLabel"
            android:text="@string/home_section_consoles" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/consolesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="2dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:descendantFocusability="afterDescendants"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_home_console" />
    </LinearLayout>
</LinearLayout>
