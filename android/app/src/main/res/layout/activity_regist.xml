<?xml version="1.0" encoding="utf-8"?>
<!-- AltyazıTR: TV için konsol eşleştirme. Solda nereden ne alınır, sağda form. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="27dp"
        android:paddingBottom="27dp">

        <!-- Sol: başlık ve yardım -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iconImageView"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_altyazi_mark"
                android:contentDescription="@string/home_content_logo" />

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/pair_title"
                android:textColor="@color/home_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pair_subtitle"
                android:textColor="@color/home_text_muted"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/pinHelpCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:background="@drawable/bg_home_card"
                android:padding="18dp">

                <TextView
                    style="@style/Pair.HelpTitle"
                    android:text="@string/pair_pin_help_title" />

                <TextView
                    android:id="@+id/pinHelpTextView"
                    style="@style/Pair.HelpBody"
                    android:text="@string/pair_pin_help_ps5" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/accountHelpCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_home_card"
                android:padding="18dp">

                <TextView
                    style="@style/Pair.HelpTitle"
                    android:text="@string/pair_account_help_title" />

                <TextView
                    style="@style/Pair.HelpBody"
                    android:text="@string/pair_account_help_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/pair_account_help_url"
                    android:textColor="@color/home_accent"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accountHelpButton"
                    style="@style/Home.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:text="@string/help_account_id_button"
                    app:icon="@drawable/ic_home_help"
                    app:iconTint="@color/home_accent"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <TextView
                android:id="@+id/secondAccountTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/pair_second_account_note"
                android:textColor="@color/home_text_faint"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Sağ: form -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.1"
            android:layout_marginStart="40dp"
            android:orientation="vertical">

            <TextView
                style="@style/Pair.SectionLabel"
                android:layout_marginTop="0dp"
                android:text="@string/pair_section_console" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <RadioGroup
                    android:id="@+id/ps4VersionRadioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/ps5RadioButton"
                        style="@style/Pair.Option"
                        android:text="@string/regist_option_ps5"
                        android:checked="true" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/ps4VersionGE8RadioButton"
                        style="@style/Pair.Option"
                        android:text="@string/regist_option_ps4_ge_8" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/ps4VersionGE7RadioButton"
                        style="@style/Pair.Option"
                        android:text="@string/regist_option_ps4_ge_7" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/ps4VersionLT7RadioButton"
                        style="@style/Pair.Option"
                        android:text="@string/regist_option_ps4_lt_7" />
                </RadioGroup>
            </HorizontalScrollView>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hostTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/pair_hint_host"
                app:startIconDrawable="@drawable/ic_host"
                app:helperText="@string/pair_hint_host_help"
                app:helperTextTextColor="@color/home_text_faint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hostEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_text"
                    android:textSize="18sp"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:imeOptions="actionNext"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/broadcastCheckBox"
                style="@style/Pair.Option"
                android:layout_marginTop="4dp"
                android:text="@string/pair_broadcast" />

            <TextView
                android:id="@+id/accountSectionLabel"
                style="@style/Pair.SectionLabel"
                android:text="@string/pair_section_account" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/psnIdTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pair_hint_account_id"
                app:startIconDrawable="@drawable/ic_psn_id">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/psnIdEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_text"
                    android:textSize="18sp"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:imeOptions="actionNext"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Pair.SectionLabel"
                android:text="@string/pair_section_pin" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/pinTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pair_hint_pin"
                app:startIconDrawable="@drawable/ic_pin">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pinEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/home_text"
                    android:textSize="22sp"
                    android:letterSpacing="0.15"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:maxLength="8" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/registButton"
                style="@style/Home.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="24dp"
                android:text="@string/pair_action"
                app:icon="@drawable/ic_home_add" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
