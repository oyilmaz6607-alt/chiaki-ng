<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AltyazıTR: TV ana ekranı -->
    <style name="HomeTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/home_accent</item>
        <item name="colorPrimaryDark">@color/home_bg</item>
        <item name="colorAccent">@color/home_accent</item>
        <item name="colorOnPrimary">@color/home_on_accent</item>
        <item name="colorSecondary">@color/home_accent</item>
        <item name="colorOnSecondary">@color/home_on_accent</item>
        <item name="colorSurface">@color/home_surface</item>
        <item name="colorOnSurface">@color/home_text</item>
        <item name="android:colorBackground">@color/home_bg</item>
        <item name="android:windowBackground">@drawable/home_background</item>
        <item name="android:statusBarColor">@color/home_bg</item>
        <item name="android:navigationBarColor">@color/home_bg</item>
        <item name="android:textColorPrimary">@color/home_text</item>
        <item name="android:textColorSecondary">@color/home_text_muted</item>
        <item name="materialAlertDialogTheme">@style/HomeTheme.Dialog</item>
        <item name="alertDialogTheme">@style/AppTheme.AlertDialog.NonMaterial</item>
    </style>

    <style name="HomeTheme.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/home_accent</item>
        <item name="colorSecondary">@color/home_accent</item>
        <item name="colorSurface">@color/home_surface</item>
        <item name="colorOnSurface">@color/home_text</item>
        <item name="android:textColorPrimary">@color/home_text</item>
        <item name="android:textColorSecondary">@color/home_text_muted</item>
        <item name="buttonBarPositiveButtonStyle">@style/HomeTheme.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/HomeTheme.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/HomeTheme.Dialog.Button</item>
    </style>

    <style name="HomeTheme.Dialog.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/home_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/home_dialog_button_bg</item>
    </style>

    <!-- Eşleştirme / elle ekleme ekranları: ana ekranla aynı renkler -->
    <style name="PairTheme" parent="MageTheme">
        <item name="colorPrimary">@color/home_surface</item>
        <item name="colorPrimaryDark">@color/home_surface_deep</item>
        <item name="colorPrimarySurface">@color/home_bg</item>
        <item name="colorAccent">@color/home_accent</item>
        <item name="colorSecondary">@color/home_accent</item>
        <item name="colorOnSecondary">@color/home_on_accent</item>
        <item name="colorOnPrimary">@color/home_text</item>
        <item name="colorControlNormal">@color/home_accent</item>
        <item name="colorButtonNormal">@color/home_accent</item>
        <item name="android:windowBackground">@color/home_bg</item>
        <item name="android:statusBarColor">@color/home_bg</item>
        <item name="android:navigationBarColor">@color/home_bg</item>
        <item name="materialAlertDialogTheme">@style/HomeTheme.Dialog</item>
        <item name="textInputStyle">@style/PairTheme.TextInputStyle</item>
    </style>

    <style name="PairTheme.TextInputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/home_accent</item>
        <item name="boxStrokeColor">@color/pair_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">3dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/home_surface_deep</item>
        <item name="startIconTint">@color/home_text_muted</item>
    </style>

    <style name="Pair" />

    <style name="Pair.SectionLabel" parent="Home.SectionLabel">
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Pair.Option">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_pair_option</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">16sp</item>
        <item name="buttonTint">@color/home_accent</item>
    </style>

    <style name="Pair.HelpTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Pair.HelpBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/home_text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Home" />

    <style name="Home.Tile">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/bg_home_tile</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="Home.TileIcon">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/home_accent</item>
    </style>

    <style name="Home.TileTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Home.TileSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/home_text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Home.Pill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/bg_home_pill</item>
        <item name="android:textColor">@color/home_pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="Home.Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/bg_home_chip</item>
    </style>

    <style name="Home.ChipText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Home.SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/home_text_faint</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Home.PrimaryButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_height">64dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/home_on_accent</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/home_primary_bg</item>
        <item name="iconTint">@color/home_on_accent</item>
        <item name="iconSize">26dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeColor">@color/home_button_stroke</item>
        <item name="strokeWidth">3dp</item>
    </style>

    <style name="Home.SecondaryButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/home_text</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/home_secondary_bg</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/home_button_stroke</item>
        <item name="strokeWidth">3dp</item>
    </style>
</resources>
